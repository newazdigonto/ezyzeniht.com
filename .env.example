# ========================================================================
# EZY Zenith LLC - cPanel MySQL Database Configuration
# ========================================================================
# Set these credentials matching your cPanel MySQL Database Wizard setup.
# If these variables are not configured or connection cannot be established,
# the app seamlessly uses local JSON fallback storage without crashing.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ezyzenith_db

# Next.js Server Port (Default: 3000)
PORT=3000

